rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidResource(data) {
      return data.title is string && data.title.size() > 0 &&
             data.description is string &&
             data.collegeId is string &&
             data.courseId is string &&
             data.subjectName is string &&
             data.resourceType in ['NOTES', 'PYQ', 'SYLLABUS', 'FORMULA_SHEET'];
    }

    function isValidSubmission(data) {
      return data.title is string && data.title.size() > 0 &&
             data.description is string &&
             data.collegeId is string &&
             data.courseId is string &&
             data.subjectName is string &&
             data.userId is string &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'];
    }

    // Published Academic Resources Collection
    // Public read and write so all CSJMU students on all devices can share and view study materials
    match /resources/{resourceId} {
      allow read, write: if true;
    }

    // Moderation Queue Submissions
    // All devices can view and submit to submissions queue
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // Student / Faculty User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}

